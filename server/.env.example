# REQUIRED: API key for ingest worker authentication
# Generate a strong random key for production
INGEST_API_KEY=super-secret-worker-key

# REQUIRED: Secret key for JWT cookie signing
# Generate a strong random key for production
JWT_SECRET=your-jwt-secret-key

# Database path for local development (relative to server directory)
DB_PATH=./mnt/data/indexer.sqlite

# Optional: Override defaults (all have sensible defaults built into the app)
# NODE_ENV=development       # Default is production for security; set to development locally
# PORT=3000
# CORS_ORIGIN=*
