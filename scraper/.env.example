# Server Configuration
# URL of the kmedia-indexer server where ingested torrents are posted
SERVER_URL=http://localhost:3000

# Authentication
# Bearer token used to authenticate POST requests to /api/v1/ingest endpoint
INGEST_API_KEY=your_api_key_here

# Scheduling
# Interval in minutes between scrape runs (used if running scraper as persistent service)
SCRAPE_INTERVAL_MINUTES=60

# HTTP Client Configuration
# User-Agent header for requests (helps avoid blocking)
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Logging
# Log level: debug, info, warn, error
LOG_LEVEL=info
